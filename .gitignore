data/source_evidence/*
!data/source_evidence/.gitkeep

# Agent reports (generated)
reports/**/*
!reports/**/.gitkeep

# Large data files
*.parquet
*.feather
*.h5
*.hdf5

# OS
.DS_Store
Thumbs.db

# Orchestration event log (local run artifacts)
data/events/*
!data/events/.gitkeep
