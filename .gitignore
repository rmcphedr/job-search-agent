# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/

# Databases
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# Outputs
outputs/*
